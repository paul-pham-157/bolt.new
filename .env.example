# Bolt.new Environment Configuration

# ============================================
# SANDBOX CONFIGURATION
# ============================================

# Sandbox Type: 'webcontainer' or 'e2b'
# - webcontainer: Browser-based, free, instant, offline support (default)
# - e2b: Cloud-based, supports databases/Python/native binaries, costs money
SANDBOX_TYPE=webcontainer

# WebContainer Configuration
WORK_DIR_NAME=bolt-project

# E2B Configuration (only needed if SANDBOX_TYPE=e2b)
# Get your API key from: https://e2b.dev/dashboard
# E2B_API_KEY=your-e2b-api-key-here
# E2B_TEMPLATE=base  # Optional: custom template
# E2B_TIMEOUT_MS=300000  # Optional: 5 minutes default

# ============================================
# AI CONFIGURATION
# ============================================

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Cloudflare Configuration
# (Used when deploying to Cloudflare Pages)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# ============================================
# DEVELOPMENT
# ============================================

# Enable debug logging
# DEBUG=bolt:*

# Node environment
NODE_ENV=development
